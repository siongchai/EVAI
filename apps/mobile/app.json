{
  "expo": {
    "name": "EVAi",
    "slug": "evai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "evai",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "primaryColor": "#00A3FF",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "sg.tsc.EVAi2",
      "buildNumber": "1",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "EVAi needs photo access to upload charging receipts, dashboard screenshots, profile photos, and car photos.",
        "NSCameraUsageDescription": "EVAi can use the camera to capture charging receipts and dashboard screenshots.",
        "NSPhotoLibraryAddUsageDescription": "EVAi may save exported files or images when you choose to share them.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1"
            ]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B1C2C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "sg.tsc.evai2",
      "versionCode": 1,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png",
      "name": "EVAi",
      "shortName": "EVAi",
      "description": "AI-powered EV charging analytics",
      "themeColor": "#0B1C2C",
      "backgroundColor": "#0B1C2C"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow EVAi to access your photos for charging receipts, dashboard screenshots, profile photos, and car images.",
          "cameraPermission": "Allow EVAi to use the camera to capture charging receipts and dashboard screenshots."
        }
      ],
      "expo-document-picker",
      "expo-sharing",
      [
        "expo-notifications",
        {
          "color": "#00A3FF",
          "defaultChannel": "monthly-summary"
        }
      ],
      [
        "expo-widgets",
        {
          "bundleIdentifier": "sg.tsc.EVAi2.widgets",
          "groupIdentifier": "group.sg.tsc.EVAi2",
          "widgets": [
            {
              "name": "MonthlySummaryWidget",
              "displayName": "Monthly Summary",
              "description": "Monthly EV charging cost and energy usage.",
              "supportedFamilies": ["systemSmall", "systemMedium"]
            },
            {
              "name": "LastSessionWidget",
              "displayName": "Last Session",
              "description": "Your most recent charging session.",
              "supportedFamilies": ["systemSmall", "systemMedium"]
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "replace-with-eas-project-id"
      }
    }
  }
}
