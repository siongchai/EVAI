EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# --- Local development (Phase 3 capture) ---
# Use either OpenAI (sk-...) or Anthropic (sk-ant-...)
EXPO_PUBLIC_OPENAI_API_KEY=
EXPO_PUBLIC_ANTHROPIC_API_KEY=
EXPO_PUBLIC_EXTRACT_PROXY_URL=http://localhost:8787
EXPO_PUBLIC_USE_EDGE_EXTRACTION=0

# --- Production / EAS / Vercel ---
# Prefer Edge Function so AI keys stay server-side:
#   supabase functions deploy extract-session
#   supabase secrets set OPENAI_API_KEY=...   # or ANTHROPIC_API_KEY in a Claude-capable function
EXPO_PUBLIC_USE_EDGE_EXTRACTION=1
# Leave browser AI keys empty in production:
# EXPO_PUBLIC_OPENAI_API_KEY=
# EXPO_PUBLIC_ANTHROPIC_API_KEY=
# EXPO_PUBLIC_EXTRACT_PROXY_URL=
